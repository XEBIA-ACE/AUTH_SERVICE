# ---------------------------------------------------------------
# Auth Service — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ---------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_APP=wsgi:application
SECRET_KEY=change-me-in-production-use-a-long-random-string

# JWT
JWT_SECRET_KEY=jwt-secret-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# PostgreSQL
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db

# Redis
REDIS_URL=redis://localhost:6379/0

# OAuth token TTLs (seconds)
OAUTH_AUTHORIZATION_CODE_EXPIRES=600
OAUTH_ACCESS_TOKEN_EXPIRES=3600
OAUTH_REFRESH_TOKEN_EXPIRES=2592000

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Password policy
BCRYPT_LOG_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# SMTP (for email verification / password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@your-domain.com

# Logging
LOG_LEVEL=INFO
